PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-strong-64-char-random-secret

# ─── SUPABASE POSTGRESQL CONNECTION (VIA PRISMA) ──────────────────────────────
# From Supabase Dashboard -> Connect -> ORMs -> Prisma:
# 1. Transaction Pooler (Port 6543) — used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"

# 2. Session Pooler or Direct Connection (Port 5432) — used by Prisma Migrate / db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── SUPABASE AUTH & EMAIL INVITES (BACKEND-ONLY) ─────────────────────────────
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public frontend URL where invited pastors land after clicking the email verification link
APP_URL="http://localhost:5173"
SUPPORT_WHATSAPP="+256 700 000 000"

# ─── MARZPAY MONTHLY SUBSCRIPTION COLLECTIONS (BACKEND-ONLY) ──────────────────
MARZPAY_API_BASE="https://wallet.wearemarz.com/api/v1"
MARZPAY_API_KEY=""
MARZPAY_API_SECRET=""
MARZPAY_BASE64_AUTHORIZATION_HEADER=""
# Optional HMAC signing secret (whsec_...) and explicit HTTPS webhook callback override:
MARZPAY_WEBHOOK_SECRET=""
MARZPAY_CALLBACK_URL=""
